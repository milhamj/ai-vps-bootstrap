model:
  default: '{{ item.model.default }}'
  provider: '{{ item.model.provider }}'
  base_url: '{{ item.model.base_url }}'
{% if item.fallback %}
fallback_model:
  provider: '{{ item.fallback.provider }}'
  model: '{{ item.fallback.default }}'
{% endif %}
# iron-proxy egress needs static provider API keys; the OAuth-based openai-codex provider has none,
# and leaving it enabled blocks Kanban tasks with "proxy.enabled is true but iron-proxy is not configured".
proxy:
  enabled: false
# Kanban routing: no auto-decomposition, and unassigned work goes to a specialist, never "default".
kanban:
  auto_decompose: {{ kanban_auto_decompose | bool | to_json }}
  default_assignee: '{{ kanban_default_assignee }}'
  orchestrator_profile: '{{ kanban_orchestrator_profile }}'
compression:
  threshold: 0.5
browser:
  cloud_provider: local
# Lists replace the profile's existing lists for these platforms; other platforms are left as-is.
platform_toolsets:
  cli: {{ item.toolsets | to_json }}
  telegram: {{ item.toolsets | to_json }}
