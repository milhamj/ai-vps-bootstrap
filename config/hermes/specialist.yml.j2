{% include 'common.yml.j2' %}

# The blank line above survives Ansible's trim_blocks, which drops the newline after the include.
terminal:
  backend: docker
  cwd: /workspace
  docker_image: '{{ hermes_docker_image }}'
  docker_mount_cwd_to_workspace: false
  docker_volumes:
    - '{{ factory_home }}/{{ factory_relative_path }}:/workspace'
  docker_forward_env: {{ agent_forward_env | to_json }}
